# --- marvels-web (Next.js storefront) ---
# Copy to .env.local for development.

NEXT_PUBLIC_SITE_URL=https://marvelsazamgarh.in
NEXT_PUBLIC_API_URL=https://api.marvelsazamgarh.in/api/v1
NEXT_PUBLIC_MEDIA_URL=https://api.marvelsazamgarh.in/media

# Cashfree JS SDK environment: sandbox | production
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Shared secret with marvels-api for on-demand ISR revalidation (== INTERNAL_SECRET in the API)
REVALIDATE_SECRET=

# Token that bypasses coming-soon mode: /?preview=<token>
PREVIEW_BYPASS_TOKEN=

# Analytics (optional; leave blank to disable)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
